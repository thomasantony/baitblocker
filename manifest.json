{
  "manifest_version": 3,
  "name": "Ragebait Filter (v0)",
  "version": "0.0.1",
  "description": "Scores x.com posts with Liquid AI d1 and hides or blurs ragebait.",
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://api.liquid.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Ragebait Filter settings" },
  "options_page": "options.html",
  "content_scripts": [
    { "matches": ["https://x.com/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://x.com/*"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
